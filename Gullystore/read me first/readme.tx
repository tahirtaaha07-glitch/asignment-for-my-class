import os, json
from fastapi import FastAPI, Request, Form
from fastapi.responses import HTMLResponse, RedirectResponse
from fastapi.templating import Jinja2Templates
from starlette.middleware.sessions import SessionMiddleware
from datetime import datetime

app = FastAPI()
app.add_middleware(SessionMiddleware, secret_key="gully_stealth_2026_pro")
templates = Jinja2Templates(directory="templates")

DATA_FILE = "data.json"
ORDERS_FILE = "orders.json"

def get_db(file=DATA_FILE):
    if not os.path.exists(file) or (file == DATA_FILE and os.path.getsize(file) < 50):
        if file == DATA_FILE:
            products = []
            imgs = {"Mobile": "https://images.unsplash.com/photo-1511707171634-5f897ff02aa9?w=500", "Laptop": "https://images.unsplash.com/photo-1496181133206-80ce9b88a853?w=500", "Watch": "https://images.unsplash.com/photo-1523275335684-37898b6baf30?w=500", "Headphones": "https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=500", "Camera": "https://images.unsplash.com/photo-1516035069371-29a1b244cc32?w=500", "Gaming": "https://images.unsplash.com/photo-1542751371-adc38448a05e?w=500"}
            brands = ["Apple", "Samsung", "Sony", "HP", "Dell", "ASUS", "Razer"]
            types = list(imgs.keys())
            for i in range(1, 1001):
                t = types[i % len(types)]
                b = brands[i % len(brands)]
                products.append({"id": i, "name": f"{b} {t} Pro {i}", "category": t, "specs": f"Global Edition {t}. 1 Year Warranty.", "price": 15000 + (i * 120), "image": imgs[t], "is_flash_sale": True if i % 10 == 0 else False})
            default = {"users": {"admin": "1234"}, "products": products, "ad": {"title": "RAMADAN MEGA SALE", "subtitle": "Up to 50% off on all items.", "price": "14,999", "image": "https://images.unsplash.com/photo-1607082348824-0a96f2a4b9da?w=1200"}}
        else:
            default = []
        with open(file, "w") as f: json.dump(default, f, indent=4)
        return default
    with open(file, "r") as f: return json.load(f)

def save_db(data, file=DATA_FILE):
    with open(file, "w") as f: json.dump(data, f, indent=4)

@app.get("/", response_class=HTMLResponse)
async def home(request: Request, q: str = None, cat: str = None):
    db = get_db()
    products = db.get("products", [])
    categories = ["Mobile", "Laptop", "Watch", "Headphones", "Camera", "Gaming"]
    ad = db.get("ad", {})
    if cat: products = [p for p in products if p.get("category") == cat]
    if q: products = [p for p in products if q.lower() in p["name"].lower()]
    return templates.TemplateResponse("home.html", {"request": request, "items": products, "categories": categories, "ad": ad, "user": request.session.get("user")})

@app.get("/login", response_class=HTMLResponse)
async def login_page(request: Request):
    return templates.TemplateResponse("login.html", {"request": request})

@app.post("/login")
async def handle_login(request: Request, username: str = Form(...), password: str = Form(...)):
    db = get_db()
    if username.lower() == "admin" and password == db["users"]["admin"]:
        request.session["user"] = {"name": "Admin", "type": "admin", "pic": "https://ui-avatars.com/api/?name=A&background=ea3a0a&color=fff"}
        return RedirectResponse(url="/admin", status_code=303)
    return RedirectResponse(url="/login")

@app.post("/auth/google")
async def google_auth(request: Request, credential: str = Form(...)):
    request.session["user"] = {"name": "Customer", "type": "google", "pic": "https://ui-avatars.com/api/?name=U&background=ea3a0a&color=fff"}
    return RedirectResponse(url="/", status_code=303)

@app.get("/admin", response_class=HTMLResponse)
async def admin(request: Request):
    user = request.session.get("user")
    if not user or user.get("type") != "admin": return RedirectResponse(url="/login")
    db = get_db()
    if not os.path.exists(ORDERS_FILE): save_db([], ORDERS_FILE)
    orders = get_db(ORDERS_FILE)
    revenue = sum(int(o['price']) for o in orders if isinstance(o, dict))
    return templates.TemplateResponse("admin.html", {"request": request, "items": db["products"], "orders": orders, "revenue": revenue, "ad": db.get("ad", {})})

@app.post("/update_ad")
async def update_ad(title: str = Form(...), subtitle: str = Form(...), price: str = Form(...), image: str = Form(...)):
    db = get_db()
    db["ad"] = {"title": title, "subtitle": subtitle, "price": price, "image": image}
    save_db(db)
    return RedirectResponse(url="/admin", status_code=303)

@app.post("/confirm_order")
async def confirm_order(request: Request, p_name: str = Form(...), p_price: int = Form(...)):
    orders = get_db(ORDERS_FILE)
    order_id = f"GULLY-{datetime.now().strftime('%M%S')}"
    orders.append({"id": order_id, "item": p_name, "price": p_price, "time": datetime.now().strftime("%Y-%m-%d %H:%M")})
    save_db(orders, ORDERS_FILE)
    msg = f"Salam! I want to buy {p_name} for Rs. {p_price:,}. ID: {order_id}"
    return RedirectResponse(url=f"https://wa.me/923327606015?text={msg.replace(' ', '%20')}", status_code=303)

@app.get("/logout")
async def logout(request: Request):
    request.session.clear()
    return RedirectResponse(url="/", status_code=303)
    # --- NEW ADMIN FEATURES START HERE ---

@app.post("/update_ad")
async def update_ad(title: str = Form(...), subtitle: str = Form(...), price: str = Form(...), image: str = Form(...)):
    db = get_db()
    db["ad"] = {"title": title, "subtitle": subtitle, "price": price, "image": image}
    save_db(db)
    return RedirectResponse(url="/admin", status_code=303)

@app.post("/edit_product/{item_id}")
async def edit_product(item_id: int, name: str = Form(...), price: int = Form(...), category: str = Form(...)):
    db = get_db()
    for p in db["products"]:
        if p["id"] == item_id:
            p["name"] = name
            p["price"] = price
            p["category"] = category
            break
    save_db(db)
    return RedirectResponse(url="/admin", status_code=303)

@app.post("/delete_product/{item_id}")
async def delete_product(item_id: int):
    db = get_db()
    db["products"] = [p for p in db["products"] if p["id"] != item_id]
    save_db(db)
    return RedirectResponse(url="/admin", status_code=303)

# Add a product manually from admin form
@app.post("/add_product")
async def add_product(name: str = Form(...), price: int = Form(...), category: str = Form(...), image: str = Form(...), specs: str = Form(...)):
    db = get_db()
    new_id = max([p["id"] for p in db["products"]]) + 1 if db["products"] else 1
    db["products"].insert(0, {
        "id": new_id, "name": name, "price": price, 
        "category": category, "image": image, "specs": specs, 
        "is_flash_sale": False
    })
    save_db(db)
    return RedirectResponse(url="/admin", status_code=303)